# Copy to .env and fill in. Never commit .env.

# Quick Access Parking Product API
QAP_API_BASE=https://quickaccessparking.co.uk/api/v1.0
QAP_API_KEY=your-quick-access-parking-api-key

# Server
PORT=4000
HOST=127.0.0.1
# Number of reverse proxies in front of the server (0 when none). Needed for correct per-visitor rate limits.
TRUST_PROXY=0
# Browser origins allowed to call this API directly (comma-separated). Leave empty when the site and API share a domain.
CORS_ORIGINS=

# Limits
RATE_LIMIT_PER_MINUTE=30
QAP_BUDGET_PER_MINUTE=100
QAP_CACHE_TTL_MS=60000
QAP_TIMEOUT_MS=15000
